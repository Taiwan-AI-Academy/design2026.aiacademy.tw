---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { path: string; alt: string; diagram?: boolean }
const { path, alt, diagram = false } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('/public/img/workshops/**/*.{png,jpg,jpeg,webp}');
const load = images[`/public/img/workshops/${path}`];
if (!load) throw new Error(`Missing workshop image: ${path}`);
const { default: image } = await load();
const original = `${import.meta.env.BASE_URL}img/workshops/${path.split('/').map(encodeURIComponent).join('/')}`;
---
<a href={original} data-wr-original aria-label={`放大：${alt}`} data-astro-prefetch="false">
  <Image src={image} alt={alt} width={diagram ? 720 : 600} format="webp" quality={80} loading="lazy" decoding="async" />
</a>
