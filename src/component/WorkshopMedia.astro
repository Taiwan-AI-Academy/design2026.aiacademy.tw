---
import WorkshopImage from './WorkshopImage.astro';
import portfolio from '../data/workshop-portfolios.json';
interface Props { school: string }
const { school } = Astro.props;
const direction = ['yzu', 'ntc'].includes(school) ? 'left' : 'right';
const files = Object.keys(import.meta.glob('/public/img/workshops/**/*.{png,jpg,jpeg,webp}')).sort();
const categories = [{ id: 'workflow', label: '工作流' }];
const works = portfolio.filter(work => work.school === school);
const localURL = (path: string) => `${import.meta.env.BASE_URL}img/workshops/${path}`;
---
{categories.map(category => {
  const paths = files.filter(path => path.startsWith(`/public/img/workshops/${school}/${category.id}/`));
  return <div class="wr-strip wr-gallery" data-wr-category={category.id} hidden>
    {paths.length ? <div class="wr-track" data-marquee={direction}>{paths.map(path => <figure class="wr-cell">
      <WorkshopImage path={path.replace('/public/img/workshops/', '')} alt={path.split('/').pop()!.replace(/\.[^.]+$/, '')} diagram />
      <figcaption>{path.split('/').pop()!.replace(/\.[^.]+$/, '')}<span>點圖放大</span></figcaption>
    </figure>)}</div> : <p class="wr-empty">{category.label}整理中，敬請期待</p>}
  </div>;
})}
<div class="wr-strip wr-portfolio" data-wr-category="portfolio" hidden>
  {works.length ? <div class="wr-track" data-marquee={direction}>
    {works.map(work => <figure class="wr-cell" data-work-id={work.id} style={`aspect-ratio: ${work.width} / ${work.height}`}>
      <a href={localURL(work.path)} data-wr-original aria-label={`放大：${work.name}`} data-astro-prefetch="false">
        <img src={localURL(work.path)} width={work.width} height={work.height} alt={work.name} loading="lazy" decoding="async" />
      </a>
      <figcaption><span title={work.name}>{work.name.replace(/\.[^.]+$/, '')}</span>
        <a href={work.url} target="_blank" rel="noopener noreferrer" aria-label={`開啟原作：${work.name}（新分頁）`}>
          {work.mimeType.startsWith('video/') ? '觀看影片 ↗' : work.mimeType === 'application/pdf' ? '閱讀 PDF ↗' : '原作 ↗'}
        </a>
      </figcaption>
    </figure>)}
  </div> : <p class="wr-empty">學員作品尚未提供</p>}
</div>
