      </div>

      <!-- 國立臺東專科學校：一場 -->
      <div class="wr-row">
        <div class="wr-info wr-info--sage">
          <div class="wr-school">AIA X 國立臺東專科學校</div>
          <div class="wr-sessions">
            <div>
              <time class="wr-date" datetime="2026-06-26">6/26（五）</time>
              <div class="wr-topic">品牌設計：AI 輔助小農形象規劃工作坊</div>
              <p class="wr-tutor">吳俊延｜OceanMax 品牌總監</p>
            </div>
          </div>
        </div>
        <div data-wr-category="photos" class="wr-strip wr-strip--short">
          <div class="wr-track" data-marquee="left">
            <div class="wr-cell"><WorkshopImage path="ntc/ntc-01.jpg" alt="國立臺東專科學校工作坊 講師示範品牌設計工具" /></div>
            <div class="wr-cell"><WorkshopImage path="ntc/ntc-02.jpg" alt="國立臺東專科學校工作坊 講師個別指導" /></div>
            <div class="wr-cell"><WorkshopImage path="ntc/ntc-03.jpg" alt="國立臺東專科學校工作坊 學員上機操作" /></div>
            <div class="wr-cell"><WorkshopImage path="ntc/ntc-04.jpg" alt="國立臺東專科學校工作坊 課堂上課情形" /></div>
            <div class="wr-cell"><WorkshopImage path="ntc/ntc-05.jpg" alt="國立臺東專科學校工作坊 學員完成的小農品牌宣傳圖" /></div>
            <div class="wr-cell"><WorkshopImage path="ntc/ntc-06.jpg" alt="國立臺東專科學校工作坊 電腦教室全景" /></div>
          </div>
        </div>
        <WorkshopMedia school="ntc" />
      </div>

      <!-- 國立宜蘭大學：一場 -->
      <div class="wr-row">
        <div class="wr-info wr-info--lime">
          <div class="wr-school">AIA X 國立宜蘭大學</div>
          <div class="wr-sessions">
            <div>
              <time class="wr-date" datetime="2026-07-16">7/16（四）</time>
              <div class="wr-topic">概念提案：AI 設計實務工作坊</div>
              <p class="wr-tutor">蘇迺薇｜資策會 主任<br>楊俊益｜智慧立方 產品經理</p>
            </div>
          </div>
        </div>
        <div data-wr-category="photos" class="wr-strip wr-strip--short">
          <div class="wr-track" data-marquee="right">
            <div class="wr-cell"><WorkshopImage path="niu/niu-01.jpg" alt="國立宜蘭大學工作坊 講師開場" /></div>
            <div class="wr-cell"><WorkshopImage path="niu/niu-02.jpg" alt="國立宜蘭大學工作坊 講師個別指導" /></div>
            <div class="wr-cell"><WorkshopImage path="niu/niu-03.jpg" alt="國立宜蘭大學工作坊 課堂上課情形" /></div>
            <div class="wr-cell"><WorkshopImage path="niu/niu-04.jpg" alt="國立宜蘭大學工作坊 學員上機操作" /></div>
          </div>
        </div>
        <WorkshopMedia school="niu" />
      </div>

    </div>
  </div>
</section>

<dialog class="wr-lightbox" aria-label="工作坊圖片原圖">
  <div class="wr-lightbox-bar"><p id="wr-image-caption"></p><button type="button" data-wr-close autofocus>關閉 ×</button></div>
  <div class="wr-lightbox-body"></div>
  <p data-wr-error hidden>原圖載入失敗，請關閉後重試。</p>
</dialog>
<script>
  const section = document.querySelector<HTMLElement>('#workshops')!;
  const tabs = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-wr-tab]'));
  const panel = section.querySelector<HTMLElement>('#wr-panel')!;
  function selectTab(tab: HTMLButtonElement) {
    tabs.forEach(button => {
      button.setAttribute('aria-selected', String(button === tab));
      button.tabIndex = button === tab ? 0 : -1;
    });
    panel.setAttribute('aria-labelledby', tab.id);
    section.dataset.category = tab.dataset.wrTab;
    section.querySelectorAll<HTMLElement>('[data-wr-category]').forEach(content => {
      content.hidden = content.dataset.wrCategory !== tab.dataset.wrTab;
    });
    section.querySelectorAll<HTMLElement>('.wr-row').forEach(row => {
      row.hidden = tab.dataset.wrTab === 'portfolio' && !row.querySelector('[data-work-id]');
    });
    section.dispatchEvent(new Event('workshop:change'));
  }
  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => selectTab(tab));
    tab.addEventListener('keydown', event => {
      const next = event.key === 'ArrowRight' ? (index + 1) % tabs.length : event.key === 'ArrowLeft' ? (index + tabs.length - 1) % tabs.length : event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : -1;
      if (next < 0) return;
      event.preventDefault(); tabs[next].focus(); selectTab(tabs[next]);
    });
  });
  const dialog = document.querySelector<HTMLDialogElement>('.wr-lightbox')!;
  const body = dialog.querySelector<HTMLElement>('.wr-lightbox-body')!;
  const caption = dialog.querySelector<HTMLElement>('#wr-image-caption')!;
  const error = dialog.querySelector<HTMLElement>('[data-wr-error]')!;
  let trigger: HTMLElement | null = null;
  let previousOverflow = '';
  section.addEventListener('click', event => {
    const link = (event.target as Element).closest<HTMLAnchorElement>('[data-wr-original]');
    if (!link || (event as MouseEvent).ctrlKey || (event as MouseEvent).metaKey || (event as MouseEvent).shiftKey || (event as MouseEvent).altKey) return;
    event.preventDefault();
    trigger = link;
    caption.textContent = link.querySelector('img')?.alt || '工作坊圖片';
    error.hidden = true;
    const image = new Image();
    image.alt = caption.textContent;
    image.addEventListener('error', () => { error.hidden = false; });
    body.replaceChildren(image);
    // Do not assign an original URL to an img until the lightbox is opened.
    image.src = link.href;
    previousOverflow = document.body.style.overflow;
    document.body.style.overflow = 'hidden';
    dialog.showModal();
  });
  dialog.querySelector('[data-wr-close]')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
  dialog.addEventListener('close', () => {
    body.replaceChildren();
    document.body.style.overflow = previousOverflow;
    trigger?.focus({ preventScroll: true });
  });
</script>
