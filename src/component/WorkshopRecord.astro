---
import WorkshopMedia from './WorkshopMedia.astro';
import WorkshopImage from './WorkshopImage.astro';
const tabs = [{ id: 'photos', label: '剪影' }, { id: 'workflow', label: '工作流' }, { id: 'portfolio', label: '作品集' }];
---
<!-- WORKSHOP RECORD -->
<section id="workshops" class="wr">
  <div class="wrap">

    <div class="top-bar">
      <div class="heading-group">
        <h2 class="main-title">工作坊紀錄 <em>WORKSHOPS</em></h2>
        <p class="wr-sub">五所學校、八場工作坊，橫跨臺灣北、中、南、東的 AI 設計實戰現場</p>
      </div>
      <div class="wr-tabs" role="tablist" aria-label="工作坊紀錄分類">
        {tabs.map((tab, index) => <button type="button" role="tab" id={`wr-tab-${tab.id}`} aria-controls="wr-panel" aria-selected={index === 0} tabindex={index === 0 ? 0 : -1} data-wr-tab={tab.id}>{tab.label}</button>)}
      </div>
    </div>

    <div class="wr-rows" id="wr-panel" role="tabpanel" aria-labelledby="wr-tab-photos" tabindex="0">

      <!-- 南臺科技大學：兩場 -->
      <div class="wr-row">
        <div class="wr-info wr-info--sage">
          <div class="wr-school">AIA X 南臺科技大學</div>
          <div class="wr-sessions">
            <div>
              <time class="wr-date" datetime="2026-05-06">5/06（三）</time>
              <div class="wr-topic">影視動畫：AI 影像生成實戰營</div>
              <p class="wr-tutor">黃飛藏｜夢想動畫 AI 產品經理</p>
            </div>
            <div>
              <time class="wr-date" datetime="2026-05-27">5/27（三）</time>
              <div class="wr-topic">商業視覺：AI 傳達設計工作坊</div>
              <p class="wr-tutor">黃綝怡｜南臺科大 視傳系主任<br>沈彥霖｜獨立視覺設計師</p>
            </div>
          </div>
        </div>
        <div data-wr-category="photos" class="wr-strip">
          <div class="wr-track" data-marquee="right">
            <div class="wr-cell"><WorkshopImage path="nantai/nantai-01.jpg" alt="南臺科技大學工作坊 講師開場簡報" /></div>
            <div class="wr-cell"><WorkshopImage path="nantai/nantai-02.jpg" alt="南臺科技大學工作坊 課堂上課情形" /></div>
            <div class="wr-cell"><WorkshopImage path="nantai/nantai-03.jpg" alt="南臺科技大學工作坊 學員上機操作" /></div>
            <div class="wr-cell"><WorkshopImage path="nantai/nantai-04.jpg" alt="南臺科技大學工作坊 講師個別指導" /></div>
            <div class="wr-cell"><WorkshopImage path="nantai/nantai-05.jpg" alt="南臺科技大學工作坊 學員以 AI 工具製作視覺" /></div>
            <div class="wr-cell"><WorkshopImage path="nantai/nantai-06.jpg" alt="南臺科技大學工作坊 學員大合照" /></div>
          </div>
        </div>
        <WorkshopMedia school="nantai" />
      </div>

      <!-- 元智大學：兩場 -->
      <div class="wr-row">
        <div class="wr-info wr-info--lime">
          <div class="wr-school">AIA X 元智大學</div>
          <div class="wr-sessions">
            <div>
              <time class="wr-date" datetime="2026-05-09">5/09（六）</time>
              <div class="wr-topic">設計方法：AI 設計工作系統</div>
              <p class="wr-tutor">邵唯晏｜竹工凡木設計研究室 創辦人</p>
            </div>
            <div>
              <time class="wr-date" datetime="2026-06-13">6/13（六）</time>
              <div class="wr-topic">產品空間：Rhino X AI 渲染工作流</div>
              <p class="wr-tutor">林楚卿｜元智大學 藝設系 系主任</p>
            </div>
          </div>
        </div>
        <div data-wr-category="photos" class="wr-strip">
          <div class="wr-track" data-marquee="left">
            <div class="wr-cell"><WorkshopImage path="yzu/yzu-01.jpg" alt="元智大學工作坊 講師示範 AI 建模與渲染" /></div>
            <div class="wr-cell"><WorkshopImage path="yzu/yzu-02.jpg" alt="元智大學工作坊 課堂上課情形" /></div>
            <div class="wr-cell"><WorkshopImage path="yzu/yzu-03.jpg" alt="元智大學工作坊 講師開場簡報" /></div>
            <div class="wr-cell"><WorkshopImage path="yzu/yzu-04.jpg" alt="元智大學工作坊 學員上機操作" /></div>
            <div class="wr-cell"><WorkshopImage path="yzu/yzu-05.jpg" alt="元智大學工作坊 講師個別指導" /></div>
            <div class="wr-cell"><WorkshopImage path="yzu/yzu-06.jpg" alt="元智大學工作坊 學員大合照" /></div>
          </div>
        </div>
        <WorkshopMedia school="yzu" />
      </div>

      <!-- 逢甲大學：兩場 -->
      <div class="wr-row">
        <div class="wr-info wr-info--sage">
          <div class="wr-school">AIA X 逢甲大學</div>
          <div class="wr-sessions">
            <div>
              <time class="wr-date" datetime="2026-06-05">6/05（五）</time>
              <div class="wr-topic">產品設計：3D 邏輯建模視覺化工作坊</div>
              <p class="wr-tutor">陳柏全｜逢甲大學 兼任助理教授</p>
            </div>
            <div>
              <time class="wr-date" datetime="2026-06-15">6/15（一）</time>
              <div class="wr-topic">室內設計：用 AI 加速空間提案工作坊</div>
              <p class="wr-tutor">李元榮｜逢甲大學 室內設計學程 主任</p>
            </div>
          </div>
        </div>
        <div data-wr-category="photos" class="wr-strip">
          <div class="wr-track" data-marquee="right">
            <div class="wr-cell"><WorkshopImage path="fcu/fcu-01.jpg" alt="逢甲大學工作坊 講師講解 AI 工作流" /></div>
            <div class="wr-cell"><WorkshopImage path="fcu/fcu-02.jpg" alt="逢甲大學工作坊 講師與學員討論" /></div>
            <div class="wr-cell"><WorkshopImage path="fcu/fcu-03.jpg" alt="逢甲大學工作坊 學員上機操作" /></div>
            <div class="wr-cell"><WorkshopImage path="fcu/fcu-04.jpg" alt="逢甲大學工作坊 課堂上課情形" /></div>
            <div class="wr-cell"><WorkshopImage path="fcu/fcu-05.jpg" alt="逢甲大學工作坊 現場活動海報與學員" /></div>
            <div class="wr-cell"><WorkshopImage path="fcu/fcu-06.jpg" alt="逢甲大學工作坊 電腦教室全景" /></div>
          </div>
        </div>
